# Copy to .env and edit. Everything except API_KEY has a default; see README.md.

# Required: clients send this as "Authorization: Bearer <API_KEY>" (or "x-api-key").
# Generate one with: openssl rand -hex 24
API_KEY=

# Folder on the host that contains the model folders, and which one to serve.
MODELS_DIR=./models
EDGE0_MODEL=Edge0-145B-q3k

# Host port and bind address.
EDGE0_PORT=8080
EDGE0_BIND=0.0.0.0

# Optional server settings (leave empty for the defaults).
CONTEXT=
DEVICE=
MODEL_ALIAS=
THINKING=
MODEL_OPTIONS=
STRATA_ARGS=
SERVE_ARGS=
READY_TIMEOUT=
TZ=UTC

# Image name and build settings (used by `docker compose build`).
EDGE0_IMAGE=edge0-infer:cuda13
CUDA_ARCHITECTURES=120
EDGE0_REF=main
